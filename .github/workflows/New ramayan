name: ramayan-daily
on:
  schedule:
    - cron: "30 18 * * *"
  workflow_dispatch:
permissions:
  contents: write
jobs:
  run:
    runs-on: ubuntu-latest
    defaults:
      run:
        working-directory: ramayan
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with: { python-version: "3.12" }
      - run: sudo apt-get update && sudo apt-get install -y ffmpeg fonts-noto-core
      - run: pip install -r requirements.txt
      - run: python generate.py
        env: { PEXELS_KEY: "${{ secrets.PEXELS_KEY }}" }
      - run: |
          cp out/video.mp4 latest.mp4
          git config user.name "bot"
          git config user.email "bot@users.noreply.github.com"
          git add latest.mp4
          git commit -m "daily video" || true
          git push
